{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Debug CLI (clgn)",
			// Edit `args` to point at the skeleton you want to render.
			"program": "${workspaceFolder}/dist/cli.js",
			"args": [
				"-i",
				"${workspaceFolder}/tests/examples/kitty-nesting-smiley/skeleton",
				"-o",
				"-"
			],
			"preLaunchTask": "npm: build:cli (bundle clgn)",
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"],
			"cwd": "${workspaceFolder}"
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Debug unit tests (Vitest)",
			"program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
			"args": ["run"],
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"],
			"cwd": "${workspaceFolder}"
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Debug current unit test file (Vitest)",
			"program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
			"args": ["run", "${relativeFile}"],
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"],
			"cwd": "${workspaceFolder}"
		}
	]
}
