{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "dev",
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"label": "npm: dev (Vite dev server)"
		},
		{
			"type": "npm",
			"script": "build",
			"problemMatcher": ["$tsc"],
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			},
			"group": "build",
			"label": "npm: build (static site)"
		},
		{
			"type": "npm",
			"script": "build:cli",
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			},
			"group": "build",
			"label": "npm: build:cli (bundle clgn)"
		},
		{
			"type": "npm",
			"script": "check",
			"problemMatcher": ["$tsc"],
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			},
			"group": "build",
			"label": "npm: check (svelte-check)"
		},
		{
			"type": "npm",
			"script": "test:unit:run",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"label": "npm: test:unit:run (Vitest)"
		},
		{
			"type": "npm",
			"script": "test:e2e:run:chromium",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": "test",
			"label": "npm: test:e2e:run:chromium (Playwright)"
		},
		{
			"type": "npm",
			"script": "lint",
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			},
			"label": "npm: lint (prettier + eslint)"
		},
		{
			"type": "npm",
			"script": "format",
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			},
			"label": "npm: format (prettier --write)"
		}
	]
}
